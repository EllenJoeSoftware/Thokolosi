<Window x:Class="Thokolosi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thokolosi" Width="430" Height="660" MinWidth="340" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Icon="pack://application:,,,/Assets/thokolosi.ico">

    <Window.Resources>
        <DataTemplate x:Key="ChatItemTemplate">
            <Border x:Name="Bubble" Margin="12,4" Padding="11,8" CornerRadius="12"
                    Background="#241F33" HorizontalAlignment="Left" MaxWidth="350">
                <TextBox x:Name="Txt" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         FontSize="13.5" FontFamily="Segoe UI"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="user">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="#5B3FE0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="activity">
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Bubble" Property="Padding" Value="4,0"/>
                    <Setter TargetName="Bubble" Property="Margin" Value="12,1"/>
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="400"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Muted}"/>
                    <Setter TargetName="Txt" Property="FontSize" Value="11.5"/>
                    <Setter TargetName="Txt" Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="error">
                    <Setter TargetName="Bubble" Property="Background" Value="#4A1E2A"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (drag to move) -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" MouseLeftButtonDown="Header_MouseDown" Padding="12,8,8,8">
            <DockPanel>
                <Image Source="pack://application:,,,/Assets/thokolosi.ico" Width="26" Height="26" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" ToolTip="New chat" Click="NewChat_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip="Settings &amp; job" Click="Settings_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" ToolTip="Hide to tray" Click="Hide_Click"/>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Thokolosi" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Mode toggles -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,0,12,9">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="AutoToggle" Style="{StaticResource ModeToggle}" Click="AutoToggle_Click"
                              ToolTip="Auto: acts without asking. Ask: you approve each action."/>
                <ToggleButton x:Name="SilentToggle" Style="{StaticResource ModeToggle}" Click="SilentToggle_Click"
                              ToolTip="Silent: works invisibly. Visible: you watch the command windows and browser."/>
                <ToggleButton x:Name="ConversationToggle" Style="{StaticResource ModeToggle}" Click="ConversationToggle_Click"
                              ToolTip="Voice conversation: after answering out loud, Thokolosi listens for your follow-up. Say nothing to end."/>
            </StackPanel>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8">
            <ItemsControl x:Name="MessagesList" ItemTemplate="{StaticResource ChatItemTemplate}"/>
        </ScrollViewer>

        <!-- Input -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10">
            <DockPanel>
                <DockPanel x:Name="AttachStrip" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            Width="22" Height="22" ToolTip="Remove attachments" Click="ClearAttachments_Click"/>
                    <TextBlock x:Name="AttachText" Foreground="{StaticResource Gold}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Send"
                        Margin="6,0,0,0" VerticalAlignment="Bottom" Click="Send_Click"/>
                <Button x:Name="MicButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE720;"
                        FontFamily="Segoe MDL2 Assets" FontSize="16" Width="34" Height="34" Margin="6,0,0,0" VerticalAlignment="Bottom"
                        ToolTip="Talk to Thokolosi (Ctrl+Alt+Space)" Click="Mic_Click"/>
                <Border Background="#241F33" CornerRadius="8" BorderBrush="#3A3350" BorderThickness="1">
                    <Grid>
                        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" MinHeight="34"
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}" FontSize="13.5"
                                 Padding="8,7" PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged">
                            <TextBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Paste" PreviewExecuted="InputBox_Paste"/>
                            </TextBox.CommandBindings>
                        </TextBox>
                        <TextBlock x:Name="Placeholder" Text="Ask Thokolosi to do something..." IsHitTestVisible="False"
                                   Foreground="#6E6787" FontSize="13.5" Margin="11,8,0,0"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
