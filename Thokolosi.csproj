<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Thokolosi</AssemblyName>
    <RootNamespace>Thokolosi</RootNamespace>
    <ApplicationIcon>Assets\thokolosi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFAC010 says to move DPI settings out of app.manifest and use ApplicationHighDpiMode. That advice is for the WinForms
      SDK, which generates the DPI entries itself. This is a WPF app (WinForms is only used for the tray icon), and WPF reads
      DPI awareness from the manifest, which is also what screenshots and UI Automation rely on for true pixel coordinates.
      The per-monitor settings are therefore intentional and stay in app.manifest, and the warning is suppressed here only.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.6.0</Version>
    <Product>Thokolosi</Product>
    <Company>EllenJoe Software</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- WPF and WinForms share type names (Application, MessageBox...). Keep WPF as the default. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.47.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- 4.8.1+ fixes GHSA-9j88-vvj5-vhgr; 4.18.x is the current stable release with the same API surface we use. -->
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\thokolosi.ico" />
    <Resource Include="Assets\face-hd.png" />
    <Resource Include="Assets\personas\*.png" />
  </ItemGroup>

</Project>

