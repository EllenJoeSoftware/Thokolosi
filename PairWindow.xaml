<Window x:Class="Thokolosi.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair your phone" Width="420" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        Topmost="True" ResizeMode="NoResize" Background="{StaticResource Bg}"
        Icon="pack://application:,,,/Assets/thokolosi.ico">
    <StackPanel Margin="24">
        <TextBlock Text="Pair your phone" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,14"
                   Text="Open the Thokolosi app on your iPhone, tap 'Pair a PC' and scan this code."/>
        <Border Background="White" CornerRadius="12" Padding="14" HorizontalAlignment="Center">
            <Grid Width="300" Height="300">
                <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock x:Name="LoadingText" Text="Creating code..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555"/>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource Text}" FontSize="13" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="ExpiryText" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0" TextAlignment="Center"/>
        <Button Style="{StaticResource PillButton}" Background="#2E2840" Content="Close" HorizontalAlignment="Center" Margin="0,14,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
